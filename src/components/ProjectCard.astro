---
import { Image } from "astro:assets";
import type { Project } from "@/data/projects";

interface Props {
  project: Project;
  /** Load the image eagerly. Use for cards above the fold only. */
  eager?: boolean;
  /** Heading level, so cards keep a valid outline on any page. */
  headingLevel?: "h2" | "h3";
  /** Position in the grid, rendered as a mono reference number. */
  index?: number;
  /** Milliseconds to offset this card's scroll reveal, for staggered grids. */
  revealDelay?: number;
}

const { project, eager = false, headingLevel = "h2", index, revealDelay = 0 } = Astro.props;
const Heading = headingLevel;
const reference = index === undefined ? undefined : String(index + 1).padStart(2, "0");
---

<a
  href={`/portfolio/${project.slug}`}
  class="project-card group block"
  data-project-card
  data-reveal
  style={revealDelay ? `--reveal-delay:${revealDelay}ms` : undefined}
>
  <div class="overflow-hidden bg-surface">
    <Image
      src={project.images[0]}
      alt={`${project.title} — ${project.shortDescription}`}
      width={1024}
      height={1280}
      loading={eager ? "eager" : "lazy"}
      decoding={eager ? "sync" : "async"}
      format="webp"
      class="aspect-[4/5] w-full object-cover transition-transform duration-[1100ms] ease-out group-hover:scale-[1.04]"
    />
  </div>

  <div class="project-card-meta mt-4 flex items-baseline justify-between gap-4 pt-3">
    <div class="flex min-w-0 items-baseline gap-3">
      {reference && <span class="mono shrink-0 text-[0.6875rem] text-muted">{reference}</span>}
      <div class="min-w-0">
        <Heading class="truncate text-[0.9375rem] font-medium tracking-[-0.015em]">{project.title}</Heading>
        <p class="mt-1 truncate text-[0.8125rem] text-muted">{project.shortDescription}</p>
      </div>
    </div>
    <span class="mono shrink-0 text-[0.6875rem] uppercase tracking-[0.05em] text-muted">{project.type}</span>
  </div>
</a>

<style>
  /* The card's top rule turns accent on hover — a quieter affordance than
     an arrow glyph on every link. */
  .project-card-meta {
    border-top: 1px solid var(--line);
    transition: border-top-color 400ms var(--ease-out-quart);
  }

  .project-card:hover .project-card-meta,
  .project-card:focus-visible .project-card-meta {
    border-top-color: var(--accent);
  }
</style>
